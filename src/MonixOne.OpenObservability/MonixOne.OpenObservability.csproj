<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PackageId>MonixOne.OpenObservability</PackageId>
        <Title>MonixOne.OpenObservability</Title>
        <Copyright>MonixOne</Copyright>
        <PackageIcon>assets/openobservability-icon.png</PackageIcon>
        <Version>1.0.4</Version>
        <Authors>Shulyakovsky.E</Authors>
        <Description>Central OpenTelemetry logs, traces and metrics for .NET 9/10 services, with Sentry integration, HTTP body masking and automatic exception diagnostics.</Description>
        <PackageTags>opentelemetry;observability;logging;tracing;metrics;sentry;http;httpclient;redaction;aspnetcore</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/Shulyakovskiy/MonixOne.OpenObservability</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Shulyakovskiy/MonixOne.OpenObservability</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageReleaseNotes>Expose safe failure summaries in logs and Sentry exception titles. HTTP body masking now retains the first 3 and last 2 characters of sensitive values longer than 12 characters; shorter values remain fully redacted. Apply the same policy to JSON arrays and repeated form values.</PackageReleaseNotes>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Microsoft.Extensions.Http.Diagnostics" />
        <PackageReference Include="Microsoft.Extensions.Compliance.Redaction" />
        <PackageReference Include="JsonMasking" />
        <PackageReference Include="Nerdbank.Streams" />
        <PackageReference Include="Refit" />
        <PackageReference Include="Polly.Core" />
        <PackageReference Include="Scrutor" />
        <PackageReference Include="Sentry.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="MonixOne.OpenObservability.Tests" />
        <None Include="../../README.md" Link="README.md" Pack="true" PackagePath="/" />
        <None Include="../../assets/openobservability-icon.png" Link="assets/openobservability-icon.png" Pack="true" PackagePath="assets/" />
    </ItemGroup>
</Project>
